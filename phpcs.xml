<?xml version="1.0"?>
<ruleset name="Project">
  <description>Project coding standard</description>

  <!-- What to scan -->
  <file>app</file>
  <file>config</file>
  <file>database</file>
  <file>routes</file>
  <file>tests</file>

  <!-- What to ignore -->
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>storage/*</exclude-pattern>
  <exclude-pattern>bootstrap/cache/*</exclude-pattern>

  <!-- Baseline standard -->
  <rule ref="PSR12"/>
</ruleset>
